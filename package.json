{
  "name": "@chebser/elma365-mcp",
  "version": "0.3.0",
  "description": "MCP-сервер для ELMA365 API с поддержкой EQL-поиска элементов приложений",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "elma365-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schebotar/elma365-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run check",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run build && vitest run tests/check",
    "smoke": "npm run build && vitest run tests/smoke",
    "probe": "npm run build && node scripts/probe.mjs",
    "coverage": "node scripts/coverage.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "elma365", "eql", "bpm", "low-code"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
